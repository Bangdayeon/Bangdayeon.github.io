# IDE settings
# 에디터 설정은 개인 것만 무시하고, 공유할 두 개는 커밋한다.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# macOS
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional eslint cache
.eslintcache

# Coverage
coverage
*.lcov

# dotenv environment variable files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Next.js build output
.next
out
next-env.d.ts

# Vercel
.vercel

# 빌드 산출물 (scripts/build-index.ts 생성 — 브리프 3장)
# config/images.json 은 커밋 대상이므로 절대 무시하지 않는다
/src/data/*
!/src/data/.gitkeep

# Obsidian (content/ 가 vault 겸용 — 절대 규칙, Phase 1 체크리스트)
.obsidian/

# 폰트: 원본(2MB)은 커밋하지 않고 서브셋만 커밋한다.
# 다시 만들려면 Pretendard 배포본의 PretendardVariable.woff2 를 이 폴더에 두고 pnpm font.
/public/fonts/*.woff2
!/public/fonts/*.subset.woff2

# 이미지 원본: R2 로 올리고(pnpm img) 주소만 config/images.json 에 남는다.
# vault 에 붙여넣은 사진은 커밋하지 않는다 — 한 번 들어가면 히스토리에서 안 빠진다.
/src/content/**/_img/

# 정적 내보내기 산출물 (pnpm build → GitHub Pages)
/out
