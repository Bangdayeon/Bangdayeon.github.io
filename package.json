{
  "name": "room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "index": "tsx scripts/build-index.ts",
    "views": "tsx scripts/fetch-views.ts",
    "img": "tsx scripts/upload-image.ts",
    "redirects": "tsx scripts/sync-redirects.ts || exit 0",
    "font": "tsx scripts/subset-font.ts",
    "build": "pnpm index && pnpm views && tsx scripts/build-static.ts",
    "build:server": "pnpm index && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "gray-matter": "^4.0.3",
    "i18next": "^26.4.0",
    "next": "^16.0.7",
    "next-i18next": "^16.0.11",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.12",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.0.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-unused-imports": "^4.3.0",
    "fontverter": "^2.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "sharp": "^0.35.4",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
